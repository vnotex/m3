@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET m3::core)
    include("${CMAKE_CURRENT_LIST_DIR}/m3Targets.cmake")
endif()
set(m3_core_FOUND TRUE)
foreach(_m3_component IN LISTS m3_FIND_COMPONENTS)
    if(_m3_component STREQUAL "qt_editor")
        set(m3_qt_editor_FOUND FALSE)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/m3QtTargets.cmake")
            find_dependency(Qt6 6.5 COMPONENTS Widgets)
            if(NOT TARGET m3::qt_editor)
                include("${CMAKE_CURRENT_LIST_DIR}/m3QtTargets.cmake")
            endif()
            set(m3_qt_editor_FOUND TRUE)
        endif()
    elseif(NOT _m3_component STREQUAL "core")
        set(m3_${_m3_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(m3)
